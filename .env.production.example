# =============================================================================
# SecureAuthX Pro — Production Environment (Vercel / managed Postgres + Redis)
# =============================================================================
# Copy to your Vercel project: Settings -> Environment Variables -> Production.
# The three secrets below were randomly generated. Rotate them if you wish.
# =============================================================================

NODE_ENV=production
APP_NAME=SecureAuthX Pro
APP_DOMAIN=your-domain.vercel.app

API_URL=https://your-domain.vercel.app
WEB_URL=https://your-domain.vercel.app

API_PORT=3000
API_BIND_ADDRESS=0.0.0.0
API_CORS_ORIGINS=https://your-domain.vercel.app

# --- Database (managed PostgreSQL — Supabase / Neon / RDS) --------------------
# Replace with the pooled connection string from your provider.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/secureauthx?schema=public

# --- Redis (serverless Redis — Upstash / Redis Cloud) -------------------------
# Format for Upstash: redis://:TOKEN@HOST:PORT
REDIS_URL=redis://:TOKEN@HOST:PORT
REDIS_PASSWORD=

# --- Security & Auth ----------------------------------------------------------
JWT_ACCESS_SECRET="lNtTbvaFwrYnM1C1yVGrA8tQTe7hK5VAs5e2Gr+bAPoAhlES62+tWaNiyFHBZI4flYEDVTD83yCeNBlMkQH/EA=="
JWT_REFRESH_SECRET="GsyP3tua2UwW89VXJJmbbfhLomxZ/b4DrJL5MOeE4a56101BHpbMcoVfNifspw9/mygP1JN3bZaGJek8BZ/b0A=="
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
JWT_ISSUER=secureauthx-pro
JWT_AUDIENCE=secureauthx-pro

COOKIE_DOMAIN=.your-domain.vercel.app
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
SESSION_TIMEOUT_MINUTES=60
IDLE_TIMEOUT_MINUTES=30
MAX_DEVICES_PER_USER=10

# --- Multi-Factor Authentication ----------------------------------------------
ENCRYPTION_KEY="KzoxqNsWxQgrUb0TT2ITqhJjwQrtlPtFgDdCYkrX90E="
WEBAUTHN_RP_ID=your-domain.vercel.app
WEBAUTHN_RP_NAME=SecureAuthX Pro
WEBAUTHN_ORIGIN=https://your-domain.vercel.app
MFA_CHALLENGE_TTL=600
RECOVERY_CODES_COUNT=10
TRUSTED_DEVICE_TTL_DAYS=30

# --- Email (SMTP — use a transactional provider) ------------------------------
# MAIL_PROVIDER: console (dev, logs only) | smtp (real SMTP, Node host) | resend (REST API)
MAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SecureAuthX Pro <no-reply@your-domain.com>
EMAIL_VERIFICATION_TTL=86400
PASSWORD_RESET_TTL=900
# RESEND_API_KEY=

# --- Rate Limiting ------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json

# --- Bootstrap admin (first deploy) -------------------------------------------
ADMIN_EMAIL=admin@your-domain.com
ADMIN_NAME=System Administrator
ADMIN_PASSWORD=CHANGE-ME-STRONG-PASSWORD-123

# --- Next.js (server + client) -------------------------------------------------
NEXT_PUBLIC_API_URL=https://your-domain.vercel.app
