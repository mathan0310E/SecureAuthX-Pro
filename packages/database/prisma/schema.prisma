// =============================================================================
// SecureAuthX Pro — Prisma Schema
// PostgreSQL 17 · UUID PKs · Indexed · Normalized · Production hardened
// =============================================================================

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  LOCKED
  DISABLED
  PENDING_VERIFICATION
}

enum SessionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum Severity {
  INFO
  WARN
  CRITICAL
}

// ---------------------------------------------------------------------------
// Core identity
// ---------------------------------------------------------------------------

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique @db.VarChar(255)
  passwordHash    String?    @db.VarChar(255) // Nullable to support passkey-only accounts
  role            UserRole   @default(USER)
  status          UserStatus @default(PENDING_VERIFICATION)
  emailVerified   Boolean    @default(false)
  emailVerifiedAt DateTime?  @db.Timestamptz(6)

  mfaEnabled      Boolean @default(false)
  totpEnabled     Boolean @default(false)
  webauthnEnabled Boolean @default(false)

  // Account security
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime? @db.Timestamptz(6)

  // Login metadata
  lastLoginAt DateTime? @db.Timestamptz(6)
  lastLoginIp String?   @db.VarChar(45)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  profile             Profile?
  sessions            Session[]
  trustedDevices      TrustedDevice[]
  auditLogs           AuditLog[]
  securityEvents      SecurityEvent[]
  emailVerifications  EmailVerification[]
  passwordResetTokens PasswordResetToken[]
  totpSecrets         TotpSecret[]
  recoveryCodes       RecoveryCode[]
  webauthnCredentials WebAuthnCredential[]
  notifications       Notification[]

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model Profile {
  id          String  @id @default(uuid()) @db.Uuid
  userId      String  @unique @db.Uuid
  firstName   String? @db.VarChar(100)
  lastName    String? @db.VarChar(100)
  displayName String? @db.VarChar(120)
  avatarUrl   String? @db.VarChar(500)
  locale      String  @default("en") @db.VarChar(10)
  timezone    String  @default("UTC") @db.VarChar(64)
  phoneNumber String? @db.VarChar(30)
  country     String? @db.VarChar(2)
  dateOfBirth String? @db.VarChar(10) // ISO date only, stored as text to avoid tz issues
  bio         String? @db.VarChar(1000)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// ---------------------------------------------------------------------------
// Sessions & devices
// ---------------------------------------------------------------------------

model Session {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  refreshTokenHash  String  @unique @db.VarChar(64) // SHA-256 of the refresh JWT jti+secret
  ipAddress         String  @db.VarChar(45)
  userAgent         String  @db.Text
  deviceName        String  @db.VarChar(255)
  deviceFingerprint String? @db.VarChar(64)

  status       SessionStatus @default(ACTIVE)
  expiresAt    DateTime      @db.Timestamptz(6)
  lastActiveAt DateTime      @default(now()) @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([expiresAt])
  @@map("sessions")
}

model TrustedDevice {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  deviceName        String   @db.VarChar(255)
  deviceFingerprint String   @db.VarChar(64)
  platform          String?  @db.VarChar(64)
  browser           String?  @db.VarChar(64)
  ipAddress         String?  @db.VarChar(45)
  trustedAt         DateTime @default(now()) @db.Timestamptz(6)
  lastUsedAt        DateTime @default(now()) @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceFingerprint])
  @@index([userId])
  @@map("trusted_devices")
}

// ---------------------------------------------------------------------------
// 2FA material
// ---------------------------------------------------------------------------

model TotpSecret {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  secret    String   @db.Text // Base32 secret; encrypted at rest by the security layer
  verified  Boolean  @default(false)
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("totp_secrets")
}

model RecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String    @unique @db.VarChar(64) // SHA-256 of the plaintext code
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, usedAt])
  @@map("recovery_codes")
}

model WebAuthnCredential {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  credentialId String   @unique @db.Text // Base64url credential ID
  publicKey    String   @db.Text // Base64url COSE public key
  signCount    Int      @default(0)
  deviceName   String   @db.VarChar(255)
  transports   String[] @default([]) // Postgres text[]
  aaguid       String?  @db.VarChar(36)
  lastUsedAt   DateTime @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("webauthn_credentials")
}

// ---------------------------------------------------------------------------
// Verification & recovery tokens
// ---------------------------------------------------------------------------

model EmailVerification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verifications")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Audit & security telemetry
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String   @db.VarChar(120)
  severity  Severity @default(INFO)
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.Text
  metadata  Json?
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model SecurityEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  type      String   @db.VarChar(80)
  severity  Severity @default(WARN)
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.Text
  metadata  Json?
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("security_events")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  type      String    @db.VarChar(60)
  title     String    @db.VarChar(200)
  body      String    @db.Text
  readAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, readAt])
  @@map("notifications")
}
