{
  "version": 3,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next",
      "config": {
        "installMode": "pnpm"
      }
    }
  ],
  "routes": [
    { "src": "^/api/(.*)$", "dest": "${API_URL}/api/$1", "middleware": [] }
  ],
  "env": {
    "NEXT_PUBLIC_API_URL": "https://api.secureauthx.vercel.app"
  },
  "ignoreCommand": "pnpm --filter @secureauthx/web build"
}