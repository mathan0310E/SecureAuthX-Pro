{
  "name": "@secureauthx/api",
  "version": "1.0.0",
  "private": true,
  "description": "SecureAuthX Pro API server (Express + TypeScript, clean architecture)",
  "main": "dist/index.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"(lint) api app\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@secureauthx/auth": "workspace:*",
    "@secureauthx/config": "workspace:*",
    "@secureauthx/database": "workspace:*",
    "@secureauthx/mail": "workspace:*",
    "@secureauthx/security": "workspace:*",
    "@secureauthx/shared": "workspace:*",
    "@secureauthx/types": "workspace:*",
    "@secureauthx/validation": "workspace:*",
    "bcrypt": "^5.1.1",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
