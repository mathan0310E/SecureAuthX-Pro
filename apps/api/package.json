{
  "name": "@secureauthx/api",
  "version": "1.0.0",
  "private": true,
  "description": "SecureAuthX Pro API (Hono, runs on Node and Cloudflare Workers)",
  "main": "dist/index.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"(lint) api app\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@prisma/client": "^6.2.1",
    "@secureauthx/auth": "workspace:*",
    "@secureauthx/config": "workspace:*",
    "@secureauthx/database": "workspace:*",
    "@secureauthx/mail": "workspace:*",
    "@secureauthx/security": "workspace:*",
    "@secureauthx/shared": "workspace:*",
    "@secureauthx/types": "workspace:*",
    "@secureauthx/validation": "workspace:*",
    "@simplewebauthn/server": "^13.3.2",
    "@upstash/redis": "^1.34.3",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "hono": "^4.6.14",
    "qrcode": "^1.5.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
