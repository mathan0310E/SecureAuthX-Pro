# =============================================================================
# SecureAuthX Pro — Cloudflare environment
# =============================================================================
# Web app (Next.js) deployment to Cloudflare Workers via @opennextjs/cloudflare.
#
# Set the values below as BUILD-TIME environment variables in your CI
# (GitHub Actions secrets) or the dashboard. Next.js inlines NEXT_PUBLIC_*
# and bakes the `/api` rewrite at build time.
#
# Secrets referenced by the API (JWT keys, DATABASE_URL, etc.) are NOT needed
# here — they belong to the API host, not the Cloudflare Worker.
# =============================================================================

# --- Application -------------------------------------------------------------
NODE_ENV=production
APP_NAME=SecureAuthX Pro
APP_DOMAIN=secureauthx-pro.your-subdomain.workers.dev

# Origin of the deployed API (Express server running on a Node host or VM).
# Used to build the same-origin `/api` rewrite. MUST be set at build time.
API_URL=https://api.your-domain.com

# Canonical origin of the deployed web app. Used for metadata, cookie flows,
# and WebAuthn origins.
WEB_URL=https://secureauthx-pro.your-subdomain.workers.dev

# Browser-facing API base (kept for Next.js client code compatibility).
NEXT_PUBLIC_API_URL=https://secureauthx-pro.your-subdomain.workers.dev

# --- WebAuthn (must match the deployed origin, not localhost) -----------------
# WEBAUTHN_RP_ID and WEBAUTHN_ORIGIN live on the API host. Keep them in sync:
#   WEBAUTHN_RP_ID=secureauthx-pro.your-subdomain.workers.dev
#   WEBAUTHN_ORIGIN=https://secureauthx-pro.your-subdomain.workers.dev
