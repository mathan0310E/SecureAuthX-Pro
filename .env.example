# =============================================================================
# SecureAuthX Pro — Environment Configuration
# Copy this file to `.env` and fill in your own values. NEVER commit `.env`.
# =============================================================================

# --- Application -------------------------------------------------------------
NODE_ENV=development
APP_NAME=SecureAuthX Pro
APP_DOMAIN=localhost
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# --- API Server --------------------------------------------------------------
API_PORT=4000
WEB_PORT=3000
API_BIND_ADDRESS=0.0.0.0
API_CORS_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL 17) -------------------------------------------------
POSTGRES_DB=secureauthx
POSTGRES_USER=secureauthx
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_PORT=5432
DATABASE_URL=postgresql://secureauthx:change-me-in-production@localhost:5432/secureauthx?schema=public

# --- Cache (Redis 7) ----------------------------------------------------------
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# --- JWT ----------------------------------------------------------------------
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=change-me-generate-with-openssl-rand-base64-64
JWT_REFRESH_SECRET=change-me-generate-with-openssl-rand-base64-64
JWT_ACCESS_TTL=900            # 15 minutes (seconds)
JWT_REFRESH_TTL=604800        # 7 days (seconds)
JWT_ISSUER=secureauthx-pro
JWT_AUDIENCE=secureauthx-pro

# --- Cookies -------------------------------------------------------------------
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false           # true when serving over HTTPS
COOKIE_SAME_SITE=lax

# --- Security ------------------------------------------------------------------
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
SESSION_TIMEOUT_MINUTES=60
IDLE_TIMEOUT_MINUTES=30
MAX_DEVICES_PER_USER=10

# --- Multi-Factor Authentication -------------------------------------------------
# AES-256-GCM key (SHA-256 derived); use `openssl rand -base64 64` in production
ENCRYPTION_KEY=change-me-encryption-key-min-16-chars
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=SecureAuthX Pro
WEBAUTHN_ORIGIN=http://localhost:3000
MFA_CHALLENGE_TTL=600          # 10 minutes (seconds)
RECOVERY_CODES_COUNT=10
TRUSTED_DEVICE_TTL_DAYS=30

# --- Email (SMTP) ---------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SecureAuthX Pro <no-reply@secureauthx.local>
EMAIL_VERIFICATION_TTL=86400    # 24 hours (seconds)
PASSWORD_RESET_TTL=900          # 15 minutes (seconds)

# --- Rate Limiting ----------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# --- Logging ----------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
LOG_DIR=logs

# --- Seed / Bootstrap ------------------------------------------------------------------
ADMIN_EMAIL=admin@secureauthx.local
ADMIN_NAME=System Administrator
ADMIN_PASSWORD=change-me-admin-password-123
